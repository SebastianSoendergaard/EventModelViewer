<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EventModelServer</AssemblyName>
    <RootNamespace>EventModelServer</RootNamespace>
    <!-- Single-file self-contained publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the server-integrated viewer HTML at build time -->
    <EmbeddedResource Include="..\..\event-model-viewer-for-server.html" LogicalName="event-model-viewer.html" />
  </ItemGroup>

  <Target Name="GenerateStaticFileVersion" BeforeTargets="BeforeCompile">
    <GetFileHash Files="..\..\event-model-viewer-for-server.html" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="StaticFileHash" />
    </GetFileHash>

    <WriteLinesToFile
      File="$(IntermediateOutputPath)GeneratedStaticFileVersion.g.cs"
      Lines="internal static class StaticFileVersion %7B public const string Value = &quot;$(StaticFileHash)&quot;%3B %7D"
      Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratedStaticFileVersion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
